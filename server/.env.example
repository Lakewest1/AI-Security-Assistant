# Supabase Auth user-token verification for POST /api/agent.
# Use the project URL and publishable key from Supabase project settings.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-project-key

# Optional server-controlled JSON map: Supabase user ID -> exact capabilities.
# Empty/unset grants nothing. Never populate this from client-controlled data.
AGENT_CAPABILITY_ALLOWLIST=
